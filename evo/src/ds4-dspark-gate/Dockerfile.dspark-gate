# Build patched ds4 binaries; runtime based on existing toolbox (no overwrite of upstream tags).
FROM registry.fedoraproject.org/fedora:44 AS builder

RUN printf "%s\n" \
  "[amdrocm-stable]" \
  "name=ROCm 10.0.0" \
  "baseurl=https://stable.repo.amd.com/rocm/core/packages/rhel10/x86_64" \
  "enabled=1" \
  "priority=50" \
  "gpgcheck=1" \
  "gpgkey=https://stable.repo.amd.com/rocm/gpg/packages.gpg" \
  > /etc/yum.repos.d/rocm.repo

RUN dnf -y --nodocs --setopt=install_weak_deps=False \
  install \
  make gcc gcc-c++ cmake libcurl-devel ninja-build \
  amdrocm-core-devel10.0-gfx1151 \
  rdma-core-devel \
  git-core \
  && dnf clean all && rm -rf /var/cache/dnf/*

ENV ROCM_PATH=/opt/rocm \
  HIP_PATH=/opt/rocm \
  PATH=/opt/rocm/bin:/opt/rocm/core/bin:/opt/rocm/core/lib/llvm/bin:$PATH \
  LD_LIBRARY_PATH=/opt/rocm/core/lib/rocm_sysdeps/lib:/opt/rocm/core/lib

WORKDIR /opt/ds4
COPY . /opt/ds4
RUN make -j"$(nproc)" strix-halo ROCM_ARCH=gfx1151 \
     CFLAGS="-O3 -ffast-math -march=native -Wall -Wextra -std=c99 -D_GNU_SOURCE -fno-finite-math-only -fPIC" \
  && cp ds4 ds4-server ds4-bench ds4-eval ds4-agent download_model.sh /usr/local/bin/ \
  && gcc -O0 -Wall -Wextra -std=c99 -I. -o /usr/local/bin/test_dspark_gate tests/test_dspark_gate.c \
  && /usr/local/bin/test_dspark_gate

FROM docker.io/kyuz0/strix-halo-ds4-toolbox:ds4.1f-rocm10.0
COPY --from=builder /usr/local/bin/ds4 /usr/local/bin/ds4
COPY --from=builder /usr/local/bin/ds4-server /usr/local/bin/ds4-server
COPY --from=builder /usr/local/bin/ds4-bench /usr/local/bin/ds4-bench
COPY --from=builder /usr/local/bin/ds4-eval /usr/local/bin/ds4-eval
COPY --from=builder /usr/local/bin/ds4-agent /usr/local/bin/ds4-agent
COPY --from=builder /usr/local/bin/test_dspark_gate /usr/local/bin/test_dspark_gate
