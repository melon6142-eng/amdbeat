# Copy to env.local and fill. Scripts source this when present.
# export EVO_CONFIRM=1   # required to actually run remote-affecting actions

export EVO_HOST="${EVO_HOST:-<host>}"
export PORT="${PORT:-8216}"
export EVO_MODELS="${EVO_MODELS:-/data/models}"
export LLAMA_SERVER="${LLAMA_SERVER:-llama-server}"   # absolute path from lab-ops
export BACKEND="${BACKEND:-rocm}"   # rocm | vulkan
export MODEL_FILE="${MODEL_FILE:-$EVO_MODELS/unsloth-Qwen3.8-27B-GGUF/Qwen3.8-27B-UD-Q6_K.gguf}"
export MODEL_ALIAS="${MODEL_ALIAS:-qwen38-27b-ud-q6k}"
export CTX="${CTX:-32768}"
export NGL="${NGL:-99}"
export BATCH="${BATCH:-2048}"
export UBATCH="${UBATCH:-512}"
export PIDFILE="${PIDFILE:-/tmp/llama-qwen38-27b-r9700.pid}"
export LOGFILE="${LOGFILE:-/tmp/llama-qwen38-27b-r9700.log}"
export HF_ENDPOINT="${HF_ENDPOINT:-https://hf-mirror.com}"
export HIP_VISIBLE_DEVICES="${HIP_VISIBLE_DEVICES:-0}"
